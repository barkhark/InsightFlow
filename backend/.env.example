# InsightFlow — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).
# ============================================================

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-to-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Default: SQLite (development)
# Production: switch to PostgreSQL by setting DB_ENGINE below

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=insightflow
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── Email (Industry: Real SMTP) ───────────────────────────────
# Development default: console backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: switch to SMTP backend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=InsightFlow <noreply@insightflow.edu>

# ── Security Headers (Industry: Production HTTPS hardening) ──
# Leave at 0 for local dev. Set to 31536000 (1 year) in production.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Enable only when deployed behind HTTPS (Nginx/Cloudflare)
SECURE_SSL_REDIRECT=False

# ── Media ────────────────────────────────────────────────────
MEDIA_URL=/media/
